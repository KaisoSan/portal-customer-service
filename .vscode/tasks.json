{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Apps Script: Push",
      "type": "shell",
      "command": "clasp push",
      "options": {
        "cwd": "${workspaceFolder}/src/appsscript"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Apps Script: Pull",
      "type": "shell",
      "command": "clasp pull",
      "options": {
        "cwd": "${workspaceFolder}/src/appsscript"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Apps Script: Open",
      "type": "shell",
      "command": "clasp open",
      "options": {
        "cwd": "${workspaceFolder}/src/appsscript"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
  "label": "Apps Script: Open Script",
  "type": "shell",
  "command": "clasp open-script",
  "options": {
    "cwd": "${workspaceFolder}/src/appsscript"
  },
  "presentation": {
    "echo": true,
    "reveal": "always",
    "panel": "shared",
    "clear": true
  },
  "problemMatcher": []
}
  ]
}

